{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "appleTeamId": "85FP2SN2JN",
        "simulator": true
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "appleTeamId": "85FP2SN2JN",
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "appleTeamId": "85FP2SN2JN",
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "appleTeamId": "85FP2SN2JN",
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
